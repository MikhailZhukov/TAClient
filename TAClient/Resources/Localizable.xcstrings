    "about_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TA Client is an iOS app for browsing and watching videos from your personal Tube Archivist server. Tube Archivist is a self-hosted media organizer that archives videos from YouTube for personal use."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TA Client — iOS-приложение для просмотра видео с вашего личного сервера Tube Archivist. Tube Archivist — это self-hosted медиа-органайзер для архивирования видео с YouTube для личного использования."
          }
        }
      }
    },
    "about_disclaimer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app provides access to videos stored on your personal Tube Archivist server. You are solely responsible for ensuring that your use of this app and any content accessed through it complies with applicable copyright laws and the terms of service of the original content platforms. The developers of this app do not host, distribute, or provide any video content."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение предоставляет доступ к видео, хранящимся на вашем личном сервере Tube Archivist. Вы несёте полную ответственность за соблюдение применимого законодательства об авторских правах и условий использования оригинальных платформ. Разработчики этого приложения не размещают, не распространяют и не предоставляют какой-либо видеоконтент."
          }
        }
      }
    },
    "about_disclaimer_header" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disclaimer"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отказ от ответственности"
          }
        }
      }
    },
    "about_header" : {
      "localizations" : {
